<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PhotoVault.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoVault.Core\PhotoVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripturile de migrare sunt incluse în assembly (portabilitate: fără fișiere .sql lângă exe) -->
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

</Project>
