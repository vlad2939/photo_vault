<!--
    Tema întunecată. Aceleași chei ca în LightTheme.xaml, valori diferite.
    Toate controalele consumă aceste resurse prin DynamicResource, deci swap-ul
    de temă se propagă instant, fără repornire (§6.11).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <!-- Culori brute (folosite și din cod: title bar DWM, umbre) -->
    <Color x:Key="Color.TitleBar">#1B1B1C</Color>
    <Color x:Key="Color.TitleBarText">#EDEDED</Color>
    <Color x:Key="Color.Shadow">#000000</Color>
    <sys:Double x:Key="Shadow.Opacity">0.45</sys:Double>

    <!-- Suprafețe -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#141415" />
    <SolidColorBrush x:Key="Brush.Bar.Background" Color="#1B1B1C" />
    <SolidColorBrush x:Key="Brush.Panel.Background" Color="#1E1E1F" />
    <SolidColorBrush x:Key="Brush.Panel.Border" Color="#2A2A2C" />
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#242426" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#171718" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1C1C1E" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#2A2A2C" />

    <!-- Controale -->
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#333336" />
    <SolidColorBrush x:Key="Brush.Control.Border.Hover" Color="#48484C" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#262628" />
    <SolidColorBrush x:Key="Brush.Control.Background.Hover" Color="#2E2E31" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#22FFFFFF" />

    <!-- Text și iconițe -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDEDED" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A3A3A6" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#6C6C70" />
    <SolidColorBrush x:Key="Brush.Icon" Color="#D8D8DA" />

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#4A4A4E" />
    <SolidColorBrush x:Key="Brush.ScrollThumb.Hover" Color="#6B6B70" />

    <!-- Popup-uri: meniuri, dropdown-uri, tooltip-uri -->
    <SolidColorBrush x:Key="Brush.Popup.Background" Color="#252527" />
    <SolidColorBrush x:Key="Brush.Popup.Border" Color="#38383B" />

    <!-- Overlay modal (dialoguri) -->
    <SolidColorBrush x:Key="Brush.Overlay" Color="#A0000000" />

    <!-- Progres -->
    <SolidColorBrush x:Key="Brush.Progress.Track" Color="#3A3A3D" />

    <!-- Culori de stare (dialoguri) -->
    <SolidColorBrush x:Key="Brush.Status.Info" Color="#4C9AFF" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="#3DBE6E" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#F5B83D" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="#F0565B" />

</ResourceDictionary>
