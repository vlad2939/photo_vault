<?xml version="1.0" encoding="utf-8"?>
<!--
    Versiunea portabilă (§8): un singur PhotoVault.exe self-contained pentru Windows x64,
    fără .NET instalat pe calculatorul țintă. Folosire:
        dotnet publish PhotoVault.App -p:PublishProfile=Portabil
    sau scriptul publish.ps1 din rădăcina repo-ului (creează și arhiva .zip).

    PublishTrimmed NU este activat: WPF nu suportă trimming (eroarea NETSDK1168), iar
    librăriile de imagine / SQLite folosesc reflecție. Dimensiunea rămâne în intervalul estimat în plan.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <!-- Fără .pdb-urile proiectelor referite (Core / Data) lângă exe: amprentă minimă (§3.2) -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\publish\PhotoVault\</PublishDir>
  </PropertyGroup>
</Project>
