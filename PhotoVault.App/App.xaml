<!--
    Resurse globale. Ordinea dicționarelor contează:
      [0] tema activă (înlocuită la runtime de ThemeManager)
      [1] accentul (generat din cod de ThemeManager, adaptat temei)
      apoi iconițe, stiluri comune și textele în limba selectată (Loc).
    Nu există StartupUri: pornirea e orchestrată în App.xaml.cs.
-->
<Application x:Class="PhotoVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PhotoVault.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PhotoVault;component/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Icons.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/Base.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/ScrollBars.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/Inputs.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/Menus.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/Lists.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/PhotoGrid.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Styles/Viewer.xaml" />
                <ResourceDictionary Source="/PhotoVault;component/Resources/Localization/Strings.ro.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:InverseBooleanConverter x:Key="InverseBoolean" />
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
