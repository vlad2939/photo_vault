<!--
    Stiluri de bază: tipografie, focus vizual, carduri/panouri.
    Brush-urile vin din tema activă (DynamicResource), deci totul se
    actualizează live la comutarea Dark/Light.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Tipografie: Segoe UI Variable (Win11), fallback Segoe UI -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13.5</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">15</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.AppTitle">22</sys:Double>

    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">12</CornerRadius>


    <!-- Text -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Icon}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Iconiță de secțiune (Bibliotecă / Albume / Tag-uri): colorată cu accentul -->
    <Style x:Key="Text.SectionIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Focus vizual la navigare cu tastatura: contur rotunjit în culoarea accentului -->
    <Style x:Key="FocusVisual.Rounded">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="10" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Card / panou: colțuri rotunjite + umbră discretă (§5.2).
        Umbra e aplicată pe un Border separat, fără copii, ca efectul să nu
        forțeze re-randarea conținutului (important pentru grid-ul virtualizat).
    -->
    <Style x:Key="Card.Panel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="{DynamicResource Radius.Panel}"
                                Background="{DynamicResource Brush.Panel.Background}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270"
                                                  Color="{DynamicResource Color.Shadow}"
                                                  Opacity="{DynamicResource Shadow.Opacity}" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="{DynamicResource Radius.Panel}"
                                Background="{DynamicResource Brush.Panel.Background}"
                                BorderBrush="{DynamicResource Brush.Panel.Border}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linie separatoare orizontală între secțiuni -->
    <Style x:Key="Divider.Horizontal" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Separator standard (în afara meniurilor) -->
    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Brush.Divider}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBlock implicit nu se stilizează global (ar afecta template-urile);
         fereastra setează FontFamily/Foreground, moștenite de tot conținutul. -->

</ResourceDictionary>
