    <sys:String x:Key="Str.Toolbar.ThemeToDark">Comută pe tema întunecată</sys:String>
    <sys:String x:Key="Str.Toolbar.Logo">PhotoVault</sys:String>
    <sys:String x:Key="Str.Library">Bibliotecă</sys:String>
    <sys:String x:Key="Str.Albums">Albume</sys:String>
    <sys:String x:Key="Str.Tags">Tag-uri</sys:String>
    <sys:String x:Key="Str.Library.Empty">Niciun folder sursă adăugat încă.</sys:String>
    <sys:String x:Key="Str.Albums.Empty">Niciun album creat.</sys:String>
    <sys:String x:Key="Str.Tags.Empty">Niciun tag creat.</sys:String>
    <sys:String x:Key="Str.Albums.Add">Album nou</sys:String>
    <sys:String x:Key="Str.Tags.Add">Tag nou</sys:String>
    <sys:String x:Key="Str.Search.Placeholder">Caută...</sys:String>
    <sys:String x:Key="Str.Sort.NameAsc">Sortează după: Nume (A → Z)</sys:String>
    <sys:String x:Key="Str.Sort.NameDesc">Sortează după: Nume (Z → A)</sys:String>
    <sys:String x:Key="Str.Grid.Empty.Title">Nicio poză indexată încă</sys:String>
    <sys:String x:Key="Str.Grid.Empty.Subtitle">Adaugă un folder cu poze folosind butonul + din secțiunea Bibliotecă.</sys:String>
    <sys:String x:Key="Str.Details.Title">Detalii</sys:String>
    <sys:String x:Key="Str.Details.Empty">Selectează o poză sau un album</sys:String>
    <sys:String x:Key="Str.Footer.Credit">© concept și realizare vlad39</sys:String>
    <sys:String x:Key="Str.Dialog.Ok">OK</sys:String>
