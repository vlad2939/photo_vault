<!--
    Texte UI — Română. Consumate în XAML prin DynamicResource și din cod prin Loc.Get(cheie).
    Ambele fișiere trebuie să conțină exact aceleași chei.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Str.Toolbar.BatchRename">Redenumire batch</sys:String>
