    <sys:String x:Key="Str.Library.AlreadyAdded">Folderul „{0}” este deja în bibliotecă.</sys:String>
    <sys:String x:Key="Str.Library.InsideExisting">Folderul „{0}” este deja inclus în biblioteca ta, ca subfolder al „{1}”. Pozele lui sunt deja indexate.</sys:String>
    <sys:String x:Key="Str.Library.ContainsExisting">Folderul „{0}” conține folderul sursă „{1}”, deja adăugat. Elimină-l mai întâi pe „{1}”, apoi adaugă folderul părinte.</sys:String>
    <sys:String x:Key="Str.Library.UnavailableTitle">Folder indisponibil</sys:String>
    <sys:String x:Key="Str.Library.Unavailable">Folderul „{0}” nu este accesibil acum (ex. disc extern deconectat). Pozele lui rămân în index; re-scanează după reconectare.</sys:String>
    <sys:String x:Key="Str.Library.RemoveTitle">Elimini folderul din bibliotecă?</sys:String>
    <sys:String x:Key="Str.Library.RemoveConfirm">Cele {1} poze din „{0}” vor fi eliminate din index, împreună cu apartenența lor la albume și tag-urile. Fișierele de pe disc NU sunt atinse.</sys:String>
    <sys:String x:Key="Str.Status.Scanning">Scanare folder...</sys:String>
    <sys:String x:Key="Str.Status.Indexing">Indexare: {0} / {1} poze</sys:String>
    <sys:String x:Key="Str.Status.Thumbnails">Generare miniaturi: {0} / {1}</sys:String>
    <sys:String x:Key="Str.Status.ThumbnailsDone">Miniaturi generate: {0}</sys:String>
    <sys:String x:Key="Str.Status.IndexDone">Indexare finalizată: {0} poze noi</sys:String>
    <sys:String x:Key="Str.Status.RescanDone">Re-scanare finalizată: {0} poze noi, {1} eliminate</sys:String>
    <sys:String x:Key="Str.Status.Removed">Folderul „{0}” a fost eliminat din bibliotecă</sys:String>
    <sys:String x:Key="Str.Grid.Count">{0} poze</sys:String>
    <sys:String x:Key="Str.Grid.CountOne">1 poză</sys:String>

</ResourceDictionary>
