    <sys:String x:Key="Str.Dialog.StartupError">Baza de date nu a putut fi inițializată. Verifică dacă folderul aplicației permite scrierea (ex. nu rulează de pe un mediu read-only).</sys:String>
    <sys:String x:Key="Str.Placeholder.Title">În curând</sys:String>
