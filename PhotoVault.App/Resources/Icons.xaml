<!--
    Iconițe: glife din fontul "Segoe Fluent Icons" (nativ pe Windows 11),
    cu fallback pe "Segoe MDL2 Assets" (aceleași coduri pentru glifele folosite).
    Stil liniar, subțire — coerent cu mockup-urile.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:String x:Key="Icon.Rename">&#xE8AC;</sys:String>
    <sys:String x:Key="Icon.Play">&#xE768;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Relocate">&#xE8DE;</sys:String>
    <sys:String x:Key="Icon.Pause">&#xE769;</sys:String>
    <sys:String x:Key="Icon.Previous">&#xE892;</sys:String>
    <sys:String x:Key="Icon.Next">&#xE893;</sys:String>
    <sys:String x:Key="Icon.Slideshow">&#xE786;</sys:String>
    <sys:String x:Key="Icon.Music">&#xE8D6;</sys:String>
    <sys:String x:Key="Icon.Volume">&#xE767;</sys:String>
    <sys:String x:Key="Icon.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.Moon">&#xE708;</sys:String>
    <sys:String x:Key="Icon.Sun">&#xE706;</sys:String>
    <sys:String x:Key="Icon.Library">&#xE8F1;</sys:String>
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.Album">&#xE8B9;</sys:String>
    <sys:String x:Key="Icon.Tag">&#xE8EC;</sys:String>
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Photo">&#xEB9F;</sys:String>
    <sys:String x:Key="Icon.Rotate">&#xE7AD;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.ChevronLeft">&#xE76B;</sys:String>
    <sys:String x:Key="Icon.Back">&#xE72B;</sys:String>
    <sys:String x:Key="Icon.ZoomIn">&#xE8A3;</sys:String>
    <sys:String x:Key="Icon.ZoomOut">&#xE71F;</sys:String>
    <sys:String x:Key="Icon.FitScreen">&#xE9A6;</sys:String>
    <sys:String x:Key="Icon.Close">&#xE711;</sys:String>
    <sys:String x:Key="Icon.Keyboard">&#xE765;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.ChevronRight">&#xE76C;</sys:String>

    <!-- Geometrii vectoriale (independente de font) pentru elementele mici din template-uri -->
    <Geometry x:Key="Geometry.Chevron">M 0,0 L 4.5,4.5 L 9,0</Geometry>
    <Geometry x:Key="Geometry.ChevronRight">M 0,0 L 4,4 L 0,8</Geometry>
    <Geometry x:Key="Geometry.Check">M 0,4.5 L 3.5,8 L 10,0.5</Geometry>

</ResourceDictionary>
