<!--
    Click pe logo (§5.4): logo-ul la dimensiune mare, peste conținutul ferestrei blurat.
    Fără texte sau bare de control. Închidere: Esc sau click.
-->
<Window x:Class="PhotoVault.App.Views.LogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoVault"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True">
    <Grid x:Name="Root" Opacity="0" Background="Black" Cursor="Hand">
        <!-- Instantaneu al ferestrei principale, blurat -->
        <Image x:Name="Backdrop" Stretch="Fill">
            <Image.Effect>
                <BlurEffect Radius="36" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
        </Image>
        <Rectangle Fill="#73000000" />

        <Image x:Name="Logo" Source="pack://application:,,,/PhotoVault;component/Resources/Images/logo.png"
               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92" />
            </Image.RenderTransform>
            <Image.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black" />
            </Image.Effect>
        </Image>
    </Grid>
</Window>
