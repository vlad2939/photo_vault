<!--
    Vizualizare poză pe tot ecranul (§6.4), cu același aspect ca slideshow-ul (§5.8):
    poza ocupă tot ecranul; stânga sus aplicația + contextul, dreapta sus numele pozei,
    jos bara de control (navigare, zoom, rotire, contor, închidere). Elementele dispar după 3 s fără mouse.
    Tastatură: ← / → navigare, + / − / 0 / 1 zoom, R rotire, Esc închide; zoom cu rotița, pan prin tragere.
-->
<Window x:Class="PhotoVault.App.Views.LightboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:PhotoVault.App.Controls"
        xmlns:vm="clr-namespace:PhotoVault.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LightboxViewModel, IsDesignTimeCreatable=False}"
        Title="{DynamicResource Str.Lightbox.Title}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        ShowInTaskbar="False" Background="Black" UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}"
        Foreground="#F2F2F2">

    <Grid Background="Black">
        <!-- Miniatura, afișată instant cât timp imaginea mare se decodează -->
        <Image Source="{Binding Current.Thumbnail}" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <ctl:ZoomPanViewer x:Name="Viewer" Source="{Binding Image}" />

        <!-- Imagine ilizibilă -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.Icon}" FontSize="40" Foreground="#80FFFFFF" Text="{DynamicResource Icon.Photo}" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="#B5B5B5"
                       Text="{DynamicResource Str.Lightbox.LoadFailed}" />
        </StackPanel>

        <!-- Încărcare imagine mare: linie subțire sus, în culoarea accentului -->
        <ProgressBar VerticalAlignment="Top" Height="2" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- ============ Elemente UI (apar / dispar împreună) ============ -->
        <Grid x:Name="Chrome">
            <!-- Stânga sus: aplicația + folderul / albumul / tag-ul afișat -->
            <Border x:Name="TitlePill" Margin="24,22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Style="{StaticResource Viewer.Pill}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="26" Height="26" Source="pack://application:,,,/PhotoVault;component/Resources/Images/logo_128.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="10,0,0,0" Style="{StaticResource Viewer.PillText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" Text="PhotoVault" />
                    <Border Width="1" Height="22" Margin="16,0" Background="{StaticResource Viewer.DividerBrush}" />
                    <TextBlock Style="{StaticResource Viewer.PillIcon}" Text="{DynamicResource Icon.Folder}" />
                    <TextBlock Margin="10,0,0,0" MaxWidth="420" Style="{StaticResource Viewer.PillText}" Text="{Binding Title}" />
                </StackPanel>
            </Border>

            <!-- Dreapta sus: numele pozei curente -->
            <Border Margin="0,22,24,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Viewer.Pill}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Viewer.PillIcon}" Foreground="#E0E0E0" Text="{DynamicResource Icon.Photo}" />
                    <TextBlock Margin="10,0,0,0" MaxWidth="360" Style="{StaticResource Viewer.PillText}" Text="{Binding Current.FileName}" />
                </StackPanel>
            </Border>

            <!-- Jos: bara de control -->
            <Border x:Name="ControlBar" Style="{StaticResource Viewer.ControlBar}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Viewer.Button}" Content="{DynamicResource Icon.Previous}"
                            Command="{Binding PreviousCommand}"
                            ToolTip="{DynamicResource Str.Lightbox.Previous}" AutomationProperties.Name="{DynamicResource Str.Lightbox.Previous}" />
                    <!-- Butonul central (cerc): potrivire în ecran -->
                    <Button Style="{StaticResource Viewer.CircleButton}" Content="{DynamicResource Icon.FitScreen}" Click="OnFitClick"
                            ToolTip="{DynamicResource Str.Lightbox.Fit}" AutomationProperties.Name="{DynamicResource Str.Lightbox.Fit}" />
                    <Button Style="{StaticResource Viewer.Button}" Content="{DynamicResource Icon.Next}"
                            Command="{Binding NextCommand}"
                            ToolTip="{DynamicResource Str.Lightbox.Next}" AutomationProperties.Name="{DynamicResource Str.Lightbox.Next}" />

                    <Border Style="{StaticResource Viewer.Divider}" />

                    <Button Style="{StaticResource Viewer.Button}" Content="{DynamicResource Icon.ZoomOut}" Click="OnZoomOutClick"
                            ToolTip="{DynamicResource Str.Lightbox.ZoomOut}" AutomationProperties.Name="{DynamicResource Str.Lightbox.ZoomOut}" />
                    <TextBlock MinWidth="56" VerticalAlignment="Center" TextAlignment="Center" FontSize="14"
                               Foreground="{StaticResource Viewer.Text}"
                               Text="{Binding ZoomPercent, ElementName=Viewer, StringFormat={}{0:0}%}" />
                    <Button Style="{StaticResource Viewer.Button}" Content="{DynamicResource Icon.ZoomIn}" Click="OnZoomInClick"
                            ToolTip="{DynamicResource Str.Lightbox.ZoomIn}" AutomationProperties.Name="{DynamicResource Str.Lightbox.ZoomIn}" />
                    <Button Style="{StaticResource Viewer.Button}" Click="OnActualSizeClick"
                            ToolTip="{DynamicResource Str.Lightbox.ActualSize}" AutomationProperties.Name="{DynamicResource Str.Lightbox.ActualSize}">
                        <TextBlock FontFamily="{DynamicResource Font.Text}" FontSize="13" FontWeight="SemiBold" Text="1:1" />
                    </Button>
                    <!-- Favorite (§12.3): inimă plină = poză favorită -->
                    <Button Command="{Binding ToggleFavoriteCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Viewer.Button}">
                                <Setter Property="Content" Value="{DynamicResource Icon.Heart}" />
                                <Setter Property="ToolTip" Value="{DynamicResource Str.Favorite.AddKey}" />
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Favorite.Add}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.IsFavorite}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource Icon.HeartFill}" />
                                        <Setter Property="ToolTip" Value="{DynamicResource Str.Favorite.RemoveKey}" />
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Favorite.Remove}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Viewer.Button}" Content="{DynamicResource Icon.Rotate}" Command="{Binding RotateCommand}"
                            ToolTip="{DynamicResource Str.Lightbox.Rotate}" AutomationProperties.Name="{DynamicResource Str.Lightbox.Rotate}" />

                    <Border Style="{StaticResource Viewer.Divider}" />
                    <TextBlock MinWidth="72" VerticalAlignment="Center" TextAlignment="Center" FontSize="15"
                               Foreground="{StaticResource Viewer.Text}" Text="{Binding CounterText}" />
                    <Border Style="{StaticResource Viewer.Divider}" />

                    <Button Style="{StaticResource Viewer.Button}" FontSize="16" Content="{DynamicResource Icon.Close}" Click="OnCloseClick"
                            ToolTip="{DynamicResource Str.Lightbox.Close}" AutomationProperties.Name="{DynamicResource Str.Lightbox.Back}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
