<!--
    Redenumire batch (§6.8): utilitar separat, pre-import, pe un folder de pe disc.
    Pattern cu variabile → previzualizare live (obligatorie) → confirmare → redenumire fizică.
-->
<ctl:ThemedWindow x:Class="PhotoVault.App.Views.BatchRenameWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ctl="clr-namespace:PhotoVault.App.Controls"
                  xmlns:vm="clr-namespace:PhotoVault.App.ViewModels"
                  xmlns:models="clr-namespace:PhotoVault.Core.Models;assembly=PhotoVault.Core"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance Type=vm:BatchRenameViewModel, IsDesignTimeCreatable=False}"
                  Title="{DynamicResource Str.Rename.Title}"
                  Icon="pack://application:,,,/PhotoVault;component/Resources/Images/icon.ico"
                  Width="1000" Height="720" MinWidth="720" MinHeight="520"
                  WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <ctl:ThemedWindow.Resources>
        <!-- Buton-jeton care inserează o variabilă în pattern -->
        <Style x:Key="Rename.TokenButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Content" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="Rename.ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <!-- Rândul din previzualizare; fără selecție (lista e doar informativă) -->
        <Style x:Key="Rename.Row" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Padding="12,7" CornerRadius="{DynamicResource Radius.Small}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Rename.RowTemplate" DataType="{x:Type vm:RenameRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding OriginalName}" ToolTip="{Binding OriginalName}" />
                <TextBlock x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource Text.Icon}" FontSize="11"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{DynamicResource Icon.ChevronRight}" />
                <TextBlock x:Name="NewName" Grid.Column="2" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Accent}" Text="{Binding NewName}" ToolTip="{Binding NewName}" />
                <StackPanel Grid.Column="3" Margin="12,0,0,0" Orientation="Horizontal">
                    <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource Brush.Status.Success}" />
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding StatusText}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RenameStatus.Unchanged}">
                    <Setter TargetName="NewName" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                    <Setter TargetName="NewName" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                    <Setter TargetName="NewName" Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Status.Error}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Arrow" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ctl:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Titlu ============ -->
            <StackPanel Margin="4,0,0,14">
                <TextBlock Style="{StaticResource Text.Title}" Text="{DynamicResource Str.Rename.Title}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextTrimming="None"
                           Text="{DynamicResource Str.Rename.Subtitle}" />
            </StackPanel>

            <!-- ============ Folder ============ -->
            <ContentControl Grid.Row="1" Style="{StaticResource Card.Panel}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Folder}" />
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.SectionHeader}"
                                       Text="{DynamicResource Str.Rename.NoFolderShort}"
                                       Visibility="{Binding HasFolder, Converter={StaticResource InverseBoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock x:Name="FolderNameText" Style="{StaticResource Text.SectionHeader}" Text="{Binding FolderName}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"
                                           Text="{Binding FileCountText}" />
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding FolderPath}"
                                       ToolTip="{Binding FolderPath}"
                                       Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button x:Name="ChooseFolderButton" Grid.Column="2" Style="{StaticResource Button.Primary}"
                                Command="{Binding ChooseFolderCommand}"
                                AutomationProperties.Name="{DynamicResource Str.Rename.ChooseFolder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{DynamicResource Font.Icons}" FontSize="13" VerticalAlignment="Center"
                                           Text="{DynamicResource Icon.Folder}" />
                                <TextBlock Margin="8,0,0,0" Text="{DynamicResource Str.Rename.ChooseFolder}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Folder deja indexat: informare (§6.8) -->
                    <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="{DynamicResource Radius.Control}"
                            Background="{DynamicResource Brush.Accent.Subtle}"
                            Visibility="{Binding IndexedInfo, Converter={StaticResource StringToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="15" VerticalAlignment="Top" Margin="0,1,0,0"
                                       Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Icon.Info}" />
                            <TextBlock x:Name="IndexedInfoText" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" TextTrimming="None" Text="{Binding IndexedInfo}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ContentControl>

            <!-- ============ Pattern ============ -->
            <ContentControl Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource Card.Panel}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="2,0,0,6" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                       Text="{DynamicResource Str.Rename.Pattern}" />
                            <TextBox x:Name="PatternBox" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Cascadia Mono, Consolas"
                                     ctl:InputHelper.Placeholder="{DynamicResource Str.Rename.PatternPlaceholder}"
                                     AutomationProperties.Name="{DynamicResource Str.Rename.Pattern}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Margin="2,0,0,6" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                       Text="{DynamicResource Str.Rename.CounterStart}" />
                            <TextBox Width="96" Text="{Binding CounterStart, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{DynamicResource Str.Rename.CounterStart}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                            <TextBlock Margin="2,0,0,6" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                       Text="{DynamicResource Str.Rename.Order}" />
                            <ComboBox MinWidth="170" SelectedIndex="{Binding OrderIndex}"
                                      AutomationProperties.Name="{DynamicResource Str.Rename.Order}">
                                <ComboBoxItem Content="{DynamicResource Str.Rename.Order.Name}" />
                                <ComboBoxItem Content="{DynamicResource Str.Rename.Order.Date}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,10,0,0" ButtonBase.Click="OnTokenClick">
                        <TextBlock Margin="2,0,10,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                                   Text="{DynamicResource Str.Rename.Insert}" />
                        <Button Style="{StaticResource Rename.TokenButton}" Tag="{}{name}" />
                        <Button Style="{StaticResource Rename.TokenButton}" Tag="{}{counter:000}" />
                        <Button Style="{StaticResource Rename.TokenButton}" Tag="{}{date}" />
                        <Button Style="{StaticResource Rename.TokenButton}" Tag="{}{date:yyyyMMdd}" />
                    </WrapPanel>

                    <TextBlock Margin="2,10,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Text="{DynamicResource Str.Rename.Help}" />
                    <TextBlock x:Name="PatternErrorText" Margin="2,8,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Status.Error}" Text="{Binding PatternError}"
                               Visibility="{Binding PatternError, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- ============ Previzualizare ============ -->
        <ContentControl Grid.Row="1" Margin="20,12,20,16" Style="{StaticResource Card.Panel}" Padding="8,12,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Rename.ColumnHeader}" Text="{DynamicResource Str.Rename.Column.Current}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Rename.ColumnHeader}" Text="{DynamicResource Str.Rename.Column.New}" />
                    <TextBlock Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource Rename.ColumnHeader}"
                               Text="{DynamicResource Str.Rename.Column.Status}" />
                </Grid>
                <Border Grid.Row="1" Margin="4,0" Style="{StaticResource Divider.Horizontal}" />

                <ListBox x:Name="PreviewList" Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding Rows}"
                         ItemContainerStyle="{StaticResource Rename.Row}" ItemTemplate="{StaticResource Rename.RowTemplate}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="{DynamicResource Str.Rename.Preview}" />

                <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"
                           Text="{Binding EmptyMessage}"
                           Visibility="{Binding EmptyMessage, Converter={StaticResource StringToVisibility}}" />
            </Grid>
        </ContentControl>

        <!-- ============ Subsol ============ -->
        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Divider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Summary}" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Error}"
                               Text="{DynamicResource Str.Rename.ConflictHint}"
                               Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}" IsCancel="True"
                            Content="{DynamicResource Str.Dialog.Close}" Click="OnCloseClick" />
                    <Button x:Name="ApplyButton" Margin="10,0,0,0" Style="{StaticResource Button.Primary}"
                            Command="{Binding ApplyCommand}"
                            AutomationProperties.Name="{DynamicResource Str.Rename.Apply}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{DynamicResource Font.Icons}" FontSize="13" VerticalAlignment="Center"
                                       Text="{DynamicResource Icon.Rename}" />
                            <TextBlock Margin="8,0,0,0" Text="{DynamicResource Str.Rename.Apply}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ctl:ThemedWindow>
