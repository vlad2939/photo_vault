<!--
    Opțiuni / Setări: foldere sursă, slideshow (durate, intensități, muzică), temă.
    Culoarea de accent și limba (Faza 7) se adaugă aici.
-->
<ctl:ThemedWindow x:Class="PhotoVault.App.Views.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ctl="clr-namespace:PhotoVault.App.Controls"
                  xmlns:vm="clr-namespace:PhotoVault.App.ViewModels"
                  xmlns:models="clr-namespace:PhotoVault.Core.Models;assembly=PhotoVault.Core"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
                  Title="{DynamicResource Str.Settings.Title}"
                  Icon="pack://application:,,,/PhotoVault;component/Resources/Images/icon.ico"
                  Width="760" Height="640" MinWidth="560" MinHeight="420"
                  WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Margin="4,0,0,14" Style="{StaticResource Text.Title}" Text="{DynamicResource Str.Settings.Title}" />

                <!-- ============ Foldere sursă ============ -->
                <ContentControl Style="{StaticResource Card.Panel}" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Library}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Settings.SourceFolders}" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding Library.AddFolderCommand}"
                                    AutomationProperties.Name="{DynamicResource Str.Library.Add}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{DynamicResource Font.Icons}" FontSize="12" VerticalAlignment="Center"
                                               Text="{DynamicResource Icon.Add}" />
                                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource Str.Library.Add}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{DynamicResource Str.Settings.SourceFoldersHint}" />

                        <TextBlock Margin="0,16,0,4" Style="{StaticResource Text.Caption}"
                                   Text="{DynamicResource Str.Library.Empty}"
                                   Visibility="{Binding Library.HasFolders, Converter={StaticResource InverseBoolToVisibility}}" />

                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Library.Folders}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="12,10" CornerRadius="{DynamicResource Radius.Control}"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="18"
                                                       Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Icon.Folder}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding FolderPath}"
                                                           ToolTip="{Binding FolderPath}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       Style="{StaticResource Text.Secondary}" Text="{Binding PhotoCountText}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Style="{StaticResource Button.Icon.Small}" Width="34" Height="34"
                                                        Content="{DynamicResource Icon.Refresh}" Command="{Binding RescanCommand}"
                                                        ToolTip="{DynamicResource Str.Library.Rescan}"
                                                        AutomationProperties.Name="{DynamicResource Str.Library.Rescan}" />
                                                <Button Style="{StaticResource Button.Icon.Small}" Width="34" Height="34" Margin="4,0,0,0"
                                                        Content="{DynamicResource Icon.Delete}" Command="{Binding RemoveCommand}"
                                                        ToolTip="{DynamicResource Str.Library.Remove}"
                                                        AutomationProperties.Name="{DynamicResource Str.Library.Remove}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <!-- ============ Slideshow (§6.10) ============ -->
                <ContentControl Margin="0,14,0,0" Style="{StaticResource Card.Panel}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Slideshow}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.SectionHeader}"
                                       Text="{DynamicResource Str.Settings.Slideshow}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{DynamicResource Str.Settings.SlideshowHint}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{DynamicResource Str.Settings.Duration}" />
                            <Slider Grid.Row="0" Grid.Column="1" Margin="16,8" Minimum="3" Maximum="15" TickFrequency="0.5"
                                    IsSnapToTickEnabled="True" Value="{Binding SlideshowSettings.DurationSec}"
                                    AutomationProperties.Name="{DynamicResource Str.Settings.Duration}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                       Style="{StaticResource Text.Secondary}" Text="{Binding SlideshowSettings.DurationText}" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{DynamicResource Str.Settings.Fade}" />
                            <Slider Grid.Row="1" Grid.Column="1" Margin="16,8" Minimum="0.5" Maximum="3" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" Value="{Binding SlideshowSettings.FadeSec}"
                                    AutomationProperties.Name="{DynamicResource Str.Settings.Fade}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                       Style="{StaticResource Text.Secondary}" Text="{Binding SlideshowSettings.FadeText}" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{DynamicResource Str.Settings.Pan}" />
                            <Slider Grid.Row="2" Grid.Column="1" Margin="16,8" Minimum="5" Maximum="25" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Value="{Binding SlideshowSettings.PanPercent}"
                                    AutomationProperties.Name="{DynamicResource Str.Settings.Pan}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                       Style="{StaticResource Text.Secondary}" Text="{Binding SlideshowSettings.PanText}" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{DynamicResource Str.Settings.Zoom}" />
                            <Slider Grid.Row="3" Grid.Column="1" Margin="16,8" Minimum="1.05" Maximum="1.3" TickFrequency="0.01"
                                    IsSnapToTickEnabled="True" Value="{Binding SlideshowSettings.ZoomFactor}"
                                    AutomationProperties.Name="{DynamicResource Str.Settings.Zoom}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                       Style="{StaticResource Text.Secondary}" Text="{Binding SlideshowSettings.ZoomText}" />
                        </Grid>

                        <Border Margin="0,14,0,14" Style="{StaticResource Divider.Horizontal}" />

                        <!-- Muzică: playlist MP3 în buclă + volum -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.SectionIcon}" FontSize="16" Text="{DynamicResource Icon.Music}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold" Text="{DynamicResource Str.Settings.Music}" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding SlideshowSettings.AddTracksCommand}"
                                    AutomationProperties.Name="{DynamicResource Str.Settings.MusicAdd}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{DynamicResource Font.Icons}" FontSize="12" VerticalAlignment="Center"
                                               Text="{DynamicResource Icon.Add}" />
                                    <TextBlock Margin="8,0,0,0" Text="{DynamicResource Str.Settings.MusicAdd}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{DynamicResource Str.Settings.MusicHint}" />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}" Text="{DynamicResource Str.Settings.MusicEmpty}"
                                   Visibility="{Binding SlideshowSettings.HasTracks, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SlideshowSettings.Tracks}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="12,6" CornerRadius="{DynamicResource Radius.Control}"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="14"
                                                       Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Icon.Music}" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}" ToolTip="{Binding Path}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Status.Error}"
                                                           Text="{DynamicResource Str.Settings.MusicMissing}"
                                                           Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Button.Icon.Small}" Width="30" Height="30"
                                                    Content="{DynamicResource Icon.Close}" Command="{Binding RemoveCommand}"
                                                    ToolTip="{DynamicResource Str.Settings.MusicRemove}"
                                                    AutomationProperties.Name="{DynamicResource Str.Settings.MusicRemove}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="14" Text="{DynamicResource Icon.Volume}" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.Body}" Text="{DynamicResource Str.Settings.Volume}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Margin="16,8" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding SlideshowSettings.Volume}" AutomationProperties.Name="{DynamicResource Str.Settings.Volume}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource Text.Secondary}"
                                       Text="{Binding SlideshowSettings.VolumeText}" />
                        </Grid>
                    </StackPanel>
                </ContentControl>

                <!-- ============ Aspect ============ -->
                <ContentControl Margin="0,14,0,0" Style="{StaticResource Card.Panel}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Moon}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.SectionHeader}"
                                       Text="{DynamicResource Str.Settings.Appearance}" />
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <RadioButton GroupName="Theme" Content="{DynamicResource Str.Settings.ThemeDark}"
                                         IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                         Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Dark}" />
                            <RadioButton GroupName="Theme" Margin="28,0,0,0" Content="{DynamicResource Str.Settings.ThemeLight}"
                                         IsChecked="{Binding IsDarkTheme, Mode=OneWay, Converter={StaticResource InverseBoolean}}"
                                         Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppTheme.Light}" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <TextBlock Margin="4,14,0,6" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                           Text="{DynamicResource Str.Settings.MoreSoon}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Divider}">
            <Button HorizontalAlignment="Right" Style="{StaticResource Button.Secondary}" IsCancel="True"
                    Content="{DynamicResource Str.Dialog.Close}" Click="OnCloseClick" />
        </Border>
    </Grid>
</ctl:ThemedWindow>
