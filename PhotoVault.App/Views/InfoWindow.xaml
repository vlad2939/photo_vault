<!--
    Modalul Info (§5.3): nume aplicație, versiune, autor, instrucțiuni scurte și lista
    scurtăturilor de tastatură. Overlay peste fereastra principală, conținut scrollabil.
-->
<Window x:Class="PhotoVault.App.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoVault"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Text}" FontSize="{DynamicResource FontSize.Body}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Grid>
        <Border x:Name="Overlay" Background="{DynamicResource Brush.Overlay}" Opacity="0" MouseLeftButtonDown="OnOverlayClick" />

        <Grid x:Name="Card" Width="560" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96" />
            </Grid.RenderTransform>

            <Border CornerRadius="{DynamicResource Radius.Dialog}" Background="{DynamicResource Brush.Panel.Background}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.35" Color="{DynamicResource Color.Shadow}" />
                </Border.Effect>
            </Border>
            <Border CornerRadius="{DynamicResource Radius.Dialog}" Background="{DynamicResource Brush.Panel.Background}"
                    BorderBrush="{DynamicResource Brush.Panel.Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Antet: logo + nume + versiune + autor -->
                    <Grid Margin="28,26,28,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="64" Height="64" Source="pack://application:,,,/PhotoVault;component/Resources/Images/logo_128.png"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Title}" FontSize="22" Text="PhotoVault" />
                            <TextBlock x:Name="VersionText" Margin="0,2,0,0" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Secondary}" Text="{DynamicResource Str.Info.Author}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,0,24,8">
                            <Border Style="{StaticResource Divider.Horizontal}" Margin="0,0,0,16" />

                            <TextBlock Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Info.HowTo}" />
                            <ItemsControl x:Name="HowToList" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="5" Height="5" Margin="2,8,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                     Fill="{DynamicResource Brush.Accent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="20"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Info.Shortcuts}" />
                            <ItemsControl x:Name="ShortcutList" Margin="0,10,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Tasta, ca un „keycap" -->
                                            <Border HorizontalAlignment="Left" Padding="8,2" CornerRadius="5" BorderThickness="1"
                                                    BorderBrush="{DynamicResource Brush.Control.Border.Hover}"
                                                    Background="{DynamicResource Brush.Surface}">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Key}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="28,14,24,20">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{DynamicResource Str.Footer.Credit}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource Button.Primary}" IsDefault="True" IsCancel="True"
                                Content="{DynamicResource Str.Dialog.Close}" Click="OnCloseClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
