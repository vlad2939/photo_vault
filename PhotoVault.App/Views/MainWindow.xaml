<!--
    Fereastra principală.
    Rânduri: bară secundară (logo + 4 butoane, §5.3) / conținut (arbore | grid | detalii) / footer (§5.5).
    Title bar-ul rămâne nativ; culoarea lui e sincronizată cu tema prin DWM.
-->
<ctl:ThemedWindow x:Class="PhotoVault.App.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ctl="clr-namespace:PhotoVault.App.Controls"
                  xmlns:vm="clr-namespace:PhotoVault.App.ViewModels"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
                  Title="PhotoVault"
                  Icon="pack://application:,,,/PhotoVault;component/Resources/Images/icon.ico"
                  Width="1440" Height="900" MinWidth="1024" MinHeight="640"
                  WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Bară secundară (§5.3) ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bar.Background}">
            <Grid Margin="18,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Stânga: logo (click → vizualizare fullscreen, Faza 2) + titlu -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Bare}" Command="{Binding OpenLogoCommand}"
                            ToolTip="{DynamicResource Str.Toolbar.Logo}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.Logo}">
                        <Image Source="pack://application:,,,/PhotoVault;component/Resources/Images/logo_128.png"
                               Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                    <TextBlock Margin="12,0,0,1" VerticalAlignment="Center" Text="PhotoVault"
                               FontFamily="{DynamicResource Font.Display}" FontSize="{DynamicResource FontSize.AppTitle}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>

                <!-- Dreapta: Redenumire batch / Info / Opțiuni / Temă -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Margin="4,0"
                            Content="{DynamicResource Icon.Rename}"
                            ToolTip="{DynamicResource Str.Toolbar.BatchRename}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.BatchRename}"
                            Command="{Binding OpenBatchRenameCommand}" />
                    <Button Style="{StaticResource Button.Icon}" Margin="4,0"
                            Content="{DynamicResource Icon.Info}"
                            ToolTip="{DynamicResource Str.Toolbar.Info}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.Info}"
                            Command="{Binding OpenInfoCommand}" />
                    <Button Style="{StaticResource Button.Icon}" Margin="4,0"
                            Content="{DynamicResource Icon.Settings}"
                            ToolTip="{DynamicResource Str.Toolbar.Settings}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.Settings}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Margin="4,0,0,0" Command="{Binding ToggleThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Setter Property="Content" Value="{DynamicResource Icon.Moon}" />
                                <Setter Property="ToolTip" Value="{DynamicResource Str.Toolbar.ThemeToLight}" />
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Toolbar.ThemeToLight}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                        <Setter Property="Content" Value="{DynamicResource Icon.Sun}" />
                                        <Setter Property="ToolTip" Value="{DynamicResource Str.Toolbar.ThemeToDark}" />
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Toolbar.ThemeToDark}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Conținut: arbore | grid | detalii ===================== -->
        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Panou stâng: Bibliotecă (arbore foldere) / Albume / Tag-uri -->
            <ContentControl Grid.Column="0" Style="{StaticResource Card.Panel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,12,14">
                        <!-- Bibliotecă -->
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Library}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Library}" />
                        </Grid>
                        <TextBlock Margin="26,6,0,4" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Library.Empty}" />

                        <Border Style="{StaticResource Divider.Horizontal}" Margin="0,14" />

                        <!-- Albume -->
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Album}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Albums}" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon.Small}"
                                    Content="{DynamicResource Icon.Add}" ToolTip="{DynamicResource Str.Albums.Add}"
                                    AutomationProperties.Name="{DynamicResource Str.Albums.Add}" />
                        </Grid>
                        <TextBlock Margin="26,6,0,4" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Albums.Empty}" />

                        <Border Style="{StaticResource Divider.Horizontal}" Margin="0,14" />

                        <!-- Tag-uri -->
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Tag}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Tags}" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon.Small}"
                                    Content="{DynamicResource Icon.Add}" ToolTip="{DynamicResource Str.Tags.Add}"
                                    AutomationProperties.Name="{DynamicResource Str.Tags.Add}" />
                        </Grid>
                        <TextBlock Margin="26,6,0,4" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Tags.Empty}" />
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

            <!-- Panou central: bară de instrumente + grid thumbnail-uri (populat din Faza 1) -->
            <ContentControl Grid.Column="2" Style="{StaticResource Card.Panel}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Căutare + sortare (funcționale în Faza 4) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 ctl:InputHelper.Placeholder="{DynamicResource Str.Search.Placeholder}"
                                 ctl:InputHelper.Icon="{DynamicResource Icon.Search}" />
                        <ComboBox Grid.Column="2" SelectedIndex="0" MinWidth="210">
                            <ComboBoxItem Content="{DynamicResource Str.Sort.NameAsc}" />
                            <ComboBoxItem Content="{DynamicResource Str.Sort.NameDesc}" />
                        </ComboBox>
                    </Grid>

                    <!-- Stare goală -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.Accent.Subtle}">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="34"
                                       Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Icon.Photo}" />
                        </Border>
                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.SectionHeader}"
                                   FontSize="17" Text="{DynamicResource Str.Grid.Empty.Title}" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360" Style="{StaticResource Text.Secondary}"
                                   Text="{DynamicResource Str.Grid.Empty.Subtitle}" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- Panou dreapta: detalii element selectat (§5.6) -->
            <ContentControl Grid.Column="4" Style="{StaticResource Card.Panel}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Text.SectionHeader}" FontSize="16" Text="{DynamicResource Str.Details.Title}" />
                    <Border Grid.Row="1" Style="{StaticResource Divider.Horizontal}" Margin="0,14,0,0" />
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="28"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{DynamicResource Icon.Info}" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource Text.Secondary}" Text="{DynamicResource Str.Details.Empty}" />
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ===================== Footer (§5.5) ===================== -->
        <ContentControl Grid.Row="2" Margin="12" Height="54" Style="{StaticResource Card.Panel}" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Stânga: mesaje de stare + bară de progres (vizibile doar când există o operațiune activă) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               Visibility="{Binding StatusText, Converter={StaticResource StringToVisibility}}" />
                    <ProgressBar Width="380" Margin="24,0,0,0" VerticalAlignment="Center"
                                 Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Dreapta: credit (text fix) -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"
                           Text="{DynamicResource Str.Footer.Credit}" />
            </Grid>
        </ContentControl>
    </Grid>
</ctl:ThemedWindow>
