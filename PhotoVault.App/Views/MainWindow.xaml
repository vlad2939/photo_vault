<!--
    Fereastra principală.
    Rânduri: bară secundară (logo + 4 butoane, §5.3) / conținut (arbore | grid | detalii) / footer (§5.5).
    Title bar-ul rămâne nativ; culoarea lui e sincronizată cu tema prin DWM.
-->
<ctl:ThemedWindow x:Class="PhotoVault.App.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ctl="clr-namespace:PhotoVault.App.Controls"
                  xmlns:vm="clr-namespace:PhotoVault.App.ViewModels"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
                  Title="PhotoVault"
                  Icon="pack://application:,,,/PhotoVault;component/Resources/Images/icon.ico"
                  Width="1440" Height="900" MinWidth="1024" MinHeight="640"
                  WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Bară secundară (§5.3) ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bar.Background}">
            <Grid Margin="18,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Stânga: logo (click → vizualizare la dimensiune mare, §5.4) + titlu -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Bare}" Command="{Binding OpenLogoCommand}"
                            ToolTip="{DynamicResource Str.Toolbar.Logo}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.Logo}">
                        <Image Source="pack://application:,,,/PhotoVault;component/Resources/Images/logo_128.png"
                               Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                    <TextBlock Margin="12,0,0,1" VerticalAlignment="Center" Text="PhotoVault"
                               FontFamily="{DynamicResource Font.Display}" FontSize="{DynamicResource FontSize.AppTitle}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>

                <!-- Dreapta: Redenumire batch / Info / Opțiuni / Temă -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Icon}" Margin="4,0"
                            Content="{DynamicResource Icon.Rename}"
                            ToolTip="{DynamicResource Str.Toolbar.BatchRename}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.BatchRename}"
                            Command="{Binding OpenBatchRenameCommand}" />
                    <Button Style="{StaticResource Button.Icon}" Margin="4,0"
                            Content="{DynamicResource Icon.Info}"
                            ToolTip="{DynamicResource Str.Toolbar.Info}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.Info}"
                            Command="{Binding OpenInfoCommand}" />
                    <Button Style="{StaticResource Button.Icon}" Margin="4,0"
                            Content="{DynamicResource Icon.Settings}"
                            ToolTip="{DynamicResource Str.Toolbar.Settings}"
                            AutomationProperties.Name="{DynamicResource Str.Toolbar.Settings}"
                            Command="{Binding OpenSettingsCommand}" />
                    <Button Margin="4,0,0,0" Command="{Binding ToggleThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Setter Property="Content" Value="{DynamicResource Icon.Moon}" />
                                <Setter Property="ToolTip" Value="{DynamicResource Str.Toolbar.ThemeToLight}" />
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Toolbar.ThemeToLight}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                        <Setter Property="Content" Value="{DynamicResource Icon.Sun}" />
                                        <Setter Property="ToolTip" Value="{DynamicResource Str.Toolbar.ThemeToDark}" />
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str.Toolbar.ThemeToDark}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Conținut: arbore | grid | detalii ===================== -->
        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Panou stâng: Bibliotecă (arbore foldere) / Albume / Tag-uri -->
            <ContentControl Grid.Column="0" Style="{StaticResource Card.Panel}" Padding="0">
                <Grid Margin="12,14,8,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Bibliotecă: click pe titlu = toate pozele; + = adaugă folder sursă -->
                    <Grid Height="34" Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Button.Bare}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding ShowAllPhotosCommand}"
                                ToolTip="{DynamicResource Str.Library.ShowAll}" AutomationProperties.Name="{DynamicResource Str.Library.ShowAll}">
                            <Border x:Name="LibraryHeader" CornerRadius="{DynamicResource Radius.Small}" Padding="4,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Context}" Value="AllPhotos">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Library}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Library}" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Button.Icon.Small}"
                                Content="{DynamicResource Icon.Add}" Command="{Binding Library.AddFolderCommand}"
                                ToolTip="{DynamicResource Str.Library.Add}"
                                AutomationProperties.Name="{DynamicResource Str.Library.Add}" />
                    </Grid>

                    <!-- Arbore foldere (subfolderele se încarcă la expandare) -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Margin="30,2,8,4" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Top"
                                   Text="{DynamicResource Str.Library.Empty}"
                                   Visibility="{Binding Library.HasFolders, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TreeView x:Name="FolderTree" ItemsSource="{Binding Library.Folders}"
                                  SelectedItemChanged="OnFolderSelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="FolderTree">
                            <TreeView.Resources>
                                <!-- Meniu contextual doar pentru folderele sursă (rădăcini) -->
                                <ContextMenu x:Key="SourceFolderMenu" x:Shared="False"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{DynamicResource Str.Library.Rescan}" Icon="{DynamicResource Icon.Refresh}"
                                              Command="{Binding RescanCommand}" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource Str.Library.Remove}" Icon="{DynamicResource Icon.Delete}"
                                              Command="{Binding RemoveCommand}" />
                                </ContextMenu>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="ToolTip" Value="{Binding FullPath}" />
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="800" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                            <Setter Property="ContextMenu" Value="{StaticResource SourceFolderMenu}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="15"
                                                   Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Icon.Folder}" />
                                        <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Body}" Text="{Binding Name}" />
                                        <TextBlock x:Name="Count" Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Caption}" Visibility="Collapsed" />
                                    </Grid>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                            <Setter TargetName="Count" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Count" Property="Text" Value="{Binding PhotoCountText}" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,4,0">
                        <Border Style="{StaticResource Divider.Horizontal}" Margin="4,12,0,10" />

                        <!-- Albume: click pe titlu = grid de carduri; click pe un album = pozele lui -->
                        <Grid Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button.Bare}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding ShowAlbumsCommand}"
                                    ToolTip="{DynamicResource Str.Albums.ShowAll}" AutomationProperties.Name="{DynamicResource Str.Albums.ShowAll}">
                                <Border CornerRadius="{DynamicResource Radius.Small}" Padding="4,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlbumsView}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Album}" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Albums}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Button.Icon.Small}"
                                    Content="{DynamicResource Icon.Add}" Command="{Binding Albums.CreateAlbumCommand}"
                                    ToolTip="{DynamicResource Str.Albums.Add}" AutomationProperties.Name="{DynamicResource Str.Albums.Add}" />
                        </Grid>
                        <TextBlock Margin="30,4,0,4" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Albums.Empty}"
                                   Visibility="{Binding Albums.HasAlbums, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ListBox MaxHeight="150" Margin="0,4,0,0" ItemsSource="{Binding Albums.Albums}"
                                 SelectedItem="{Binding Albums.ActiveAlbum, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource Library.FolderItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="AlbumList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" AutomationProperties.Name="{Binding Name}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource Str.Albums.Edit}" Command="{Binding EditCommand}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Str.Albums.Delete}" Icon="{DynamicResource Icon.Delete}"
                                                          Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" Text="{DynamicResource Icon.Album}" />
                                        <TextBlock Grid.Column="1" Margin="10,0,8,0" Style="{StaticResource Text.Body}" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{Binding PhotoCountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource Divider.Horizontal}" Margin="4,10,0,10" />

                        <!-- Tag-uri: click pe un tag = pozele care îl au -->
                        <Grid Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="4,0,0,0" Style="{StaticResource Text.SectionIcon}" Text="{DynamicResource Icon.Tag}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Tags}" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon.Small}"
                                    Content="{DynamicResource Icon.Add}" Command="{Binding Tags.CreateTagCommand}"
                                    ToolTip="{DynamicResource Str.Tags.Add}" AutomationProperties.Name="{DynamicResource Str.Tags.Add}" />
                        </Grid>
                        <TextBlock Margin="30,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Tags.Empty}"
                                   Visibility="{Binding Tags.HasTags, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ListBox MaxHeight="150" Margin="0,4,0,0" ItemsSource="{Binding Tags.Tags}"
                                 SelectedItem="{Binding Tags.ActiveTag, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource Library.FolderItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="TagList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" AutomationProperties.Name="{Binding Name}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{DynamicResource Str.Tags.Rename}" Command="{Binding RenameCommand}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Str.Tags.Delete}" Icon="{DynamicResource Icon.Delete}"
                                                          Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="14"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" Text="{DynamicResource Icon.Tag}" />
                                        <TextBlock Grid.Column="1" Margin="10,0,8,0" Style="{StaticResource Text.Body}" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{Binding PhotoCountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- Panou central: bară de instrumente + grid thumbnail-uri -->
            <ContentControl Grid.Column="2" Style="{StaticResource Card.Panel}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Bara de context: ce se afișează (toate pozele / folder / albume / album / tag) + număr -->
                    <Grid Margin="2,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Din interiorul unui album: înapoi la grid-ul de albume -->
                        <Button Style="{StaticResource Button.Icon.Small}" Margin="-4,0,6,0" Content="{DynamicResource Icon.Back}"
                                Command="{Binding ShowAlbumsCommand}"
                                ToolTip="{DynamicResource Str.Albums.Back}" AutomationProperties.Name="{DynamicResource Str.Albums.Back}"
                                Visibility="{Binding IsAlbumContext, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.SectionIcon}" Text="{Binding ContextIcon}" />
                        <TextBlock Grid.Column="2" Margin="10,0,12,0" VerticalAlignment="Center" Style="{StaticResource Text.SectionHeader}"
                                   FontSize="16" Text="{Binding ContextTitle}" AutomationProperties.AutomationId="ContextTitle" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"
                                   Text="{Binding Grid.CountText}"
                                   Visibility="{Binding IsPhotosView, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Căutare (nume fișier + tag-uri + albume, Ctrl+F) + sortare după nume (§6.7) -->
                    <Grid Grid.Row="1" Visibility="{Binding IsPhotosView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ctl:InputHelper.Placeholder="{DynamicResource Str.Search.Placeholder}"
                                 ctl:InputHelper.Icon="{DynamicResource Icon.Search}"
                                 ToolTip="{DynamicResource Str.Search.Tooltip}"
                                 AutomationProperties.Name="{DynamicResource Str.Search.Placeholder}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding SortIndex}" MinWidth="200">
                            <ComboBoxItem Content="{DynamicResource Str.Sort.NameAsc}" />
                            <ComboBoxItem Content="{DynamicResource Str.Sort.NameDesc}" />
                        </ComboBox>
                    </Grid>

                    <!-- ============ Poze ============ -->
                    <Grid Grid.Row="2" Visibility="{Binding IsPhotosView, Converter={StaticResource BoolToVisibility}}">
                    <!-- Grid miniaturi: virtualizat (doar rândurile vizibile au containere) -->
                    <ListBox x:Name="PhotoList" Margin="-6,8,-10,-8" ItemsSource="{Binding Grid.Photos}"
                             PreviewMouseLeftButtonDown="OnPhotoListMouseDown"
                             SelectionChanged="OnPhotoSelectionChanged"
                             ContextMenuOpening="OnPhotoContextMenuOpening"
                             SelectionMode="Extended"
                             SelectedItem="{Binding Grid.SelectedPhoto, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PhotoCard.Container}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="PhotoGrid"
                             Visibility="{Binding Grid.IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                        <ListBox.ContextMenu>
                            <!-- Construit la deschidere (listele de albume / tag-uri sunt dinamice) -->
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.InputBindings>
                            <!-- Enter → lightbox (dublu-click: OnPhotoListMouseDown); R → rotire 90° -->
                            <KeyBinding Key="Enter" Command="{Binding Grid.OpenCommand}" />
                            <KeyBinding Key="R" Command="{Binding RotateCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:VirtualizingWrapPanel ItemMinWidth="170" ImageAspectRatio="1.333" ItemFooterHeight="42" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Folder fără poze -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding Grid.IsFolderEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="30"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{DynamicResource Icon.Folder}" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Secondary}"
                                   Text="{DynamicResource Str.Grid.FolderEmpty}" />
                    </StackPanel>

                    <!-- Căutare fără rezultate -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding Grid.IsSearchEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="30"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{DynamicResource Icon.Search}" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Secondary}"
                                   Text="{DynamicResource Str.Search.NoResults}" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource Button.Secondary}"
                                Content="{DynamicResource Str.Search.Clear}" Command="{Binding ClearSearchCommand}" />
                    </StackPanel>

                    <!-- Bibliotecă goală -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding Grid.IsLibraryEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.Accent.Subtle}">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="34"
                                       Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Icon.Photo}" />
                        </Border>
                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.SectionHeader}"
                                   FontSize="17" Text="{DynamicResource Str.Grid.Empty.Title}" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360" Style="{StaticResource Text.Secondary}"
                                   Text="{DynamicResource Str.Grid.Empty.Subtitle}" />
                    </StackPanel>
                    </Grid>

                    <!-- ============ Albume: grid de carduri (§5.7) ============ -->
                    <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsAlbumsView, Converter={StaticResource BoolToVisibility}}">
                        <ListBox x:Name="AlbumCards" Margin="-6,0,-10,-8" ItemsSource="{Binding Albums.Albums}"
                                 SelectedItem="{Binding Albums.SelectedAlbum, Mode=TwoWay}"
                                 PreviewMouseLeftButtonDown="OnAlbumCardsMouseDown"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="AlbumGrid"
                                 Visibility="{Binding Albums.HasAlbums, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:VirtualizingWrapPanel ItemMinWidth="190" ImageAspectRatio="1.333" ItemFooterHeight="62" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Albums.SelectedAlbum.OpenCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource AlbumCard.Container}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource Str.Albums.Open}" Command="{Binding OpenCommand}" />
                                                <MenuItem Header="{DynamicResource Str.Albums.Edit}" Command="{Binding EditCommand}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Str.Albums.Delete}" Icon="{DynamicResource Icon.Delete}"
                                                          Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Niciun album -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                    Visibility="{Binding Albums.HasAlbums, Converter={StaticResource InverseBoolToVisibility}}">
                            <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center"
                                    Background="{DynamicResource Brush.Accent.Subtle}">
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="34"
                                           Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Icon.Album}" />
                            </Border>
                            <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.SectionHeader}"
                                       FontSize="17" Text="{DynamicResource Str.Albums.EmptyTitle}" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="380" Style="{StaticResource Text.Secondary}" TextTrimming="None"
                                       Text="{DynamicResource Str.Albums.EmptyHint}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ContentControl>

            <!-- Panou dreapta: detalii element selectat (§5.6) — nimic / poză / album -->
            <ContentControl Grid.Column="4" Style="{StaticResource Card.Panel}" Padding="0">
                <Grid>
                    <!-- Nicio selecție -->
                    <Grid Margin="18,16" Visibility="{Binding DetailsMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=None}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Text.SectionHeader}" FontSize="16" Text="{DynamicResource Str.Details.Title}" />
                        <Border Grid.Row="1" Style="{StaticResource Divider.Horizontal}" Margin="0,14,0,0" />
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Icon}" FontSize="28"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{DynamicResource Icon.Info}" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource Text.Secondary}" Text="{DynamicResource Str.Details.Empty}" />
                        </StackPanel>
                    </Grid>

                    <!-- Poza selectată -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding DetailsMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Photo}">
                        <StackPanel Margin="18,16,14,16">
                            <TextBlock Style="{StaticResource Text.SectionHeader}" FontSize="16" TextWrapping="Wrap" TextTrimming="None"
                                       Text="{Binding Details.Photo.FileName}" />
                            <Border Style="{StaticResource Divider.Horizontal}" Margin="0,14,0,10" />

                            <ItemsControl ItemsSource="{Binding Details.Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12.5" TextWrapping="Wrap"
                                                       TextTrimming="None" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Value}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Divider.Horizontal}" Margin="0,14" />

                            <!-- Tag-uri: etichete cu „×"; „+" deschide lista de tag-uri existente + „Tag nou…" -->
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.SectionHeader}" Text="{DynamicResource Str.Tags}" />
                                <Button x:Name="AddTagButton" HorizontalAlignment="Right" Style="{StaticResource Button.Icon.Small}"
                                        Content="{DynamicResource Icon.Add}" Click="OnAddTagClick"
                                        ToolTip="{DynamicResource Str.Details.AddTag}" AutomationProperties.Name="{DynamicResource Str.Details.AddTag}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}" Text="{DynamicResource Str.Details.NoTags}"
                                       Visibility="{Binding Details.HasTags, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Details.Tags}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,8,8" Padding="10,3,4,3" CornerRadius="{DynamicResource Radius.Small}"
                                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Accent}"
                                                Background="{DynamicResource Brush.Accent.Subtle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" FontSize="12.5" Text="{Binding Name}" />
                                                <Button Style="{StaticResource TagChip.RemoveButton}" Content="{DynamicResource Icon.Close}"
                                                        Command="{Binding DataContext.Details.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{DynamicResource Str.Details.RemoveTag}"
                                                        AutomationProperties.Name="{DynamicResource Str.Details.RemoveTag}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Albumul selectat (click pe card): nume, dată, număr de poze — fără a-l deschide -->
                    <StackPanel Margin="18,16,14,16"
                                Visibility="{Binding DetailsMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Album}">
                        <Border Height="150" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Brush.Surface}">
                            <Grid>
                                <TextBlock Style="{StaticResource Text.Icon}" FontSize="34"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{DynamicResource Icon.Album}" />
                                <Border CornerRadius="{DynamicResource Radius.Control}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Albums.SelectedAlbum.Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.SectionHeader}" FontSize="16" TextWrapping="Wrap"
                                   TextTrimming="None" Text="{Binding Albums.SelectedAlbum.Name}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{Binding Albums.SelectedAlbum.Subtitle}"
                                   Visibility="{Binding Albums.SelectedAlbum.HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource Divider.Horizontal}" Margin="0,14,0,10" />
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12.5" Text="{DynamicResource Str.Details.Created}" />
                            <TextBlock Grid.Column="1" FontSize="12.5" Text="{Binding Albums.SelectedAlbum.DateText}" />
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12.5" Text="{DynamicResource Str.Details.PhotoCount}" />
                            <TextBlock Grid.Column="1" FontSize="12.5" Text="{Binding Albums.SelectedAlbum.PhotoCountText}" />
                        </Grid>
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}"
                                    Content="{DynamicResource Str.Albums.Open}" Command="{Binding Albums.SelectedAlbum.OpenCommand}" />
                            <Button Margin="10,0,0,0" Style="{StaticResource Button.Secondary}"
                                    Content="{DynamicResource Str.Albums.EditShort}" Command="{Binding Albums.SelectedAlbum.EditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- ===================== Footer (§5.5) ===================== -->
        <ContentControl Grid.Row="2" Margin="12" Height="54" Style="{StaticResource Card.Panel}" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Stânga: mesaje de stare + bară de progres (vizibile doar când există o operațiune activă) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                               Text="{Binding Status.StatusText}"
                               Visibility="{Binding Status.StatusText, Converter={StaticResource StringToVisibility}}" />
                    <ProgressBar Width="380" Margin="24,0,0,0" VerticalAlignment="Center"
                                 Maximum="{Binding Status.ProgressMaximum}" Value="{Binding Status.ProgressValue}"
                                 IsIndeterminate="{Binding Status.IsIndeterminate}"
                                 Visibility="{Binding Status.IsProgressVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Dreapta: credit (text fix) -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"
                           Text="{DynamicResource Str.Footer.Credit}" />
            </Grid>
        </ContentControl>
    </Grid>
</ctl:ThemedWindow>
