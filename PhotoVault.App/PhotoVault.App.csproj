<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoVault.App</RootNamespace>
    <!-- Executabilul se numește PhotoVault.exe (§3.2) -->
    <AssemblyName>PhotoVault</AssemblyName>
    <ApplicationIcon>Resources\Images\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoVault.Core\PhotoVault.Core.csproj" />
    <ProjectReference Include="..\PhotoVault.Data\PhotoVault.Data.csproj" />
  </ItemGroup>

  <!-- README.txt din folderul portabil (§3.2): doar la publicare, nu și în bin/ -->
  <ItemGroup>
    <None Include="Portable\README.txt" Link="README.txt" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\logo.png" />
    <Resource Include="Resources\Images\logo_128.png" />
    <Resource Include="Resources\Images\icon.ico" />
  </ItemGroup>

</Project>
